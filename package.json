{
  "name": "canvas-lms-mcp-local",
  "version": "1.2.0",
  "description": "Student-focused Canvas LMS MCP server: 237 tools for grades, deadlines, planning, submissions and study plans. Runs locally over stdio, with a one-command setup for Claude, ChatGPT, Cursor, VS Code and more.",
  "mcpName": "io.github.Fireiscoolsolo/canvas-lms-mcp-local",
  "type": "module",
  "main": "index.js",
  "bin": {
    "canvas-lms-mcp-local": "index.js"
  },
  "scripts": {
    "start": "node index.js",
    "test": "node --test",
    "sync-core": "node scripts/sync-core.mjs",
    "build-mcpb": "node scripts/build-mcpb.mjs"
  },
  "files": [
    "index.js",
    "cli.js",
    "core/",
    "lib/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "canvas",
    "canvas-lms",
    "instructure",
    "lms",
    "students",
    "education",
    "study-planner",
    "ai-assistant",
    "claude",
    "chatgpt",
    "planner"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fireiscoolsolo/canvas-lms-mcp-local.git"
  },
  "homepage": "https://fireiscoolsolo.github.io/canvas-lms-mcp-local/",
  "bugs": {
    "url": "https://github.com/Fireiscoolsolo/canvas-lms-mcp-local/issues"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "dotenv": "^16.4.5",
    "jszip": "^3.10.2",
    "smol-toml": "^1.9.1",
    "unpdf": "~1.8.1",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=18"
  }
}
