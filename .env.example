# Copy this file to .env (in this same folder) and fill in your own values.
# Never share or commit .env.

# --- Required ---
# Canvas > Account > Settings > Approved Integrations > + New Access Token
CANVAS_API_TOKEN=paste_your_canvas_token_here
# Your school's Canvas address (with or without /api/v1)
CANVAS_BASE_URL=https://yourschool.instructure.com

# --- Optional ---
# CANVAS_ALLOW_WRITES=true          # false = read-only (removes state-changing tools)
# CANVAS_PROFILE=full               # core = smaller curated tool set
# CANVAS_CACHE_TTL=60
# CANVAS_TIMEZONE=America/New_York
# CANVAS_DOWNLOAD_DIR=C:\Users\you\Downloads\canvas
